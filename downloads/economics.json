  "scope": {
    "locationCount": 1,
    "platformCount": 1,
    "timeZoneCount": 1,
    "weeklyCoverageHours": 60,
    "includedCalls": 400,
    "includedTasks": 300,
    "callDefinition": "Conversation plus wrap; a follow-up call counts once as a call, not again as task",
    "taskDefinition": "One defined administrative attempt including record update",
    "afterHours": "Excluded outside named 60-hour local weekly window"
  },
  "formulas": {
    "humanHours": "(calls * totalCallHandleMinutes + tasks * totalTaskMinutes) / 60 + exceptionHours",
    "paidHoursPerFTE": "40 * 52 / 12",
    "productiveHoursPerFTE": "paidHoursPerFTE * (1 - shrinkage) * occupancy",
    "productiveHourlyCost": "loadedPaidHourlyCost / ((1 - shrinkage) * occupancy)",
    "frontlineLabor": "humanHours * productiveHourlyCost",
    "directCost": "frontlineLabor + technology + quality + clientSupport",
    "grossProfit": "monthlyRevenue - directCost",
    "grossMargin": "grossProfit / monthlyRevenue",
    "contribution": "grossProfit - retentionExpense",
    "contributionMargin": "contribution / monthlyRevenue",
    "paybackMonths": "(CAC + max(0, onboardingCost - setupFee)) / contribution",
    "breakEvenClients": "ceil(fixedMonthlyExpense / contribution), finite only if contribution > 0",
    "annualRetention": "(1 - monthlyChurn)^12",
    "contributionLTV24": "contribution * ((1 - (1 - monthlyChurn)^24) / monthlyChurn)",
    "netValue24": "contributionLTV24 + setupFee - onboardingCost - CAC",
    "cashBreakEvenWithReplacement": "Smallest integer n where n*contribution - fixedMonthlyExpense - max(monthlyCommercialFloor,n*monthlyChurn*CAC) + n*monthlyChurn*(setupFee-onboardingCost) >= 0. No finite result if contribution + monthlyChurn*(setupFee-onboardingCost-CAC) <= 0.",
    "frontlineFTE": "ceil(activeClients * humanHours / productiveHoursPerFTE), subject to larger coverage and arrival-interval requirement",
    "marketTAM": "anchorEstablishments * monthlyRevenue * 12",
    "marketSAMLocations": "floor(anchorEstablishments * relevantResidentialServiceShare * suitableSizeBudgetShare * platformOutsourcingFitShare)",
    "marketSAMRevenue": "marketSAMLocations * monthlyRevenue * 12",
    "marketSOMRevenue": "obtainableActiveClients * monthlyRevenue * 12",
    "qualityBudget": "At least USD365/client/month in all three scenarios, derived from the ten-client oversight roster; apply the larger cohort floor when needed.",
    "cohortFrontlineCost": "max(2.5,ceil(activeClients*humanHours/productiveHoursPerFTE))*productiveHoursPerFTE*productiveHourlyCost",
    "cohortQualityCost": "max(activeClients*quality,pilot or cohort oversight floor at productive-hour cost,required supervisors plus case review)"
  },
